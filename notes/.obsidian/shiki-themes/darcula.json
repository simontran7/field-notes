{
  "name": "Darcula",
  "type": "dark",
  "colors": {
    "editor.background": "#2b2b2b",
    "editor.foreground": "#a9b7c6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "storage.type.class.javadoc"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "bold italic underline"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "constant.language",
        "variable.language",
        "support.type.primitive",
        "storage.type.primitive",
        "entity.name.type.primitive",
        "entity.name.type.numeric"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a9b7c6"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.question",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6a8759"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#6897bb"
      }
    },
    {
      "scope": [
        "punctuation.terminator",
        "punctuation.separator.comma",
        "punctuation.separator.delimiter",
        "punctuation.semi",
        "punctuation.comma"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#ffc66d"
      }
    },
    {
      "scope": [
        "meta.function-call entity.name.function",
        "meta.method-call entity.name.function",
        "entity.name.function.call"
      ],
      "settings": {
        "foreground": "#a9b7c6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "storage.type.java",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "entity.name.command"
      ],
      "settings": {
        "foreground": "#a9b7c6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "constant.other.option",
        "string.unquoted.argument.shell"
      ],
      "settings": {
        "foreground": "#a9b7c6",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.field"
      ],
      "settings": {
        "foreground": "#9876aa"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "constant.other.caps",
        "constant.other"
      ],
      "settings": {
        "foreground": "#9876aa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.attribute.rust",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#bbb529"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#e8bf6a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#bababa"
      }
    },
    {
      "scope": [
        "meta.attribute string",
        "meta.tag string"
      ],
      "settings": {
        "foreground": "#a5c261"
      }
    },
    {
      "scope": [
        "source.rust entity.name.function"
      ],
      "settings": {
        "foreground": "#ffc66d"
      }
    },
    {
      "scope": [
        "entity.name.function.macro.rust",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#4eade5"
      }
    },
    {
      "scope": [
        "entity.name.type.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#20999d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type.rust",
        "entity.name.type.struct.rust"
      ],
      "settings": {
        "foreground": "#86985d"
      }
    },
    {
      "scope": [
        "entity.name.type.enum.rust"
      ],
      "settings": {
        "foreground": "#86985d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type.trait.rust"
      ],
      "settings": {
        "foreground": "#8d91dc"
      }
    },
    {
      "scope": [
        "entity.name.type.primitive.rust",
        "entity.name.type.numeric.rust"
      ],
      "settings": {
        "foreground": "#cc7832"
      }
    },
    {
      "scope": [
        "variable.language.self.rust"
      ],
      "settings": {
        "foreground": "#d98eb3"
      }
    },
    {
      "scope": [
        "keyword.operator.question.rust"
      ],
      "settings": {
        "foreground": "#cc7832",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "comment.line.documentation.rust",
        "comment.block.documentation.rust"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.javadoc punctuation.definition.comment",
        "comment.block.documentation punctuation.definition.comment",
        "comment.line.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#629755",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.javadoc variable.parameter",
        "comment.block.documentation variable.other.jsdoc",
        "comment.block.documentation variable.parameter"
      ],
      "settings": {
        "foreground": "#8a653b",
        "fontStyle": "italic"
      }
    }
  ]
}